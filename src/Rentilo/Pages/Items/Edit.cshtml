@page "{id:int}"
@model Rentilo.Pages.Items.EditModel
@{
    var form = new ItemFormModel(Model.Input, Model.CurrentImage, "Save changes");
    ViewData["Title"] = "Edit listing";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="page-header pt-2 d-flex justify-content-between align-items-end gap-3 flex-wrap">
                <div>
                    <a asp-page="Details" asp-route-id="@Model.ItemId" class="small text-decoration-none">← Back to listing</a>
                    <h1 class="mt-1">Edit listing</h1>
                </div>
                <a asp-page="Delete" asp-route-id="@Model.ItemId" class="btn btn-outline-danger btn-sm">Delete listing</a>
            </div>
            <form method="post" enctype="multipart/form-data" class="form-card">
                <partial name="_ItemForm" model="form" />
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
