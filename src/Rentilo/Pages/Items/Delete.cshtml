@page "{id:int}"
@model Rentilo.Pages.Items.DeleteModel
@{
    ViewData["Title"] = "Delete listing";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="form-card text-center">
                <div class="fs-1" aria-hidden="true">🗑️</div>
                <h1 class="h3 mt-2">Delete “@Model.Item.Title”?</h1>
                @if (Model.HasActiveBookings)
                {
                    <p class="text-muted">This item has pending or upcoming bookings. Decline or finish them before deleting.</p>
                    <a class="btn btn-primary" asp-page="/Dashboard/Requests">Go to requests</a>
                }
                else
                {
                    <p class="text-muted">
                        @if (Model.HasBookings)
                        {
                            <text>This item has past bookings, so it will be <strong>paused and hidden</strong> to keep renters' history intact.</text>
                        }
                        else
                        {
                            <text>This permanently removes the listing and its photo.</text>
                        }
                    </p>
                    <form method="post" class="d-flex gap-2 justify-content-center">
                        <a class="btn btn-soft" asp-page="Edit" asp-route-id="@Model.Item.Id">Cancel</a>
                        <button type="submit" class="btn btn-danger">@(Model.HasBookings ? "Pause listing" : "Delete listing")</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
