@page
@model Rentilo.Pages.Items.CreateModel
@{
    var form = new ItemFormModel(Model.Input, null, "Publish listing");
    ViewData["Title"] = "List an item";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="page-header pt-2">
                <span class="eyebrow">New listing</span>
                <h1>List an item</h1>
                <p class="text-muted mb-0">Good photos and an honest description get the most requests.</p>
            </div>
            <form method="post" enctype="multipart/form-data" class="form-card">
                <partial name="_ItemForm" model="form" />
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
