@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}
<div class="container py-5">
    <div class="empty-state">
        <div class="emoji" aria-hidden="true">🛠️</div>
        <h1 class="h3 mt-2">Something went wrong</h1>
        <p class="text-muted">Sorry, an unexpected error occurred. Please try again in a moment.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" asp-page="/Index">Go home</a>
    </div>
</div>
