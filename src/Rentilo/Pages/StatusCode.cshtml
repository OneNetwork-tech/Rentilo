@page
@model StatusCodeModel
@{
    ViewData["Title"] = Model.Heading;
}
<div class="container py-5">
    <div class="empty-state mx-auto">
        <div class="emoji" aria-hidden="true">@(Model.Code == 404 ? "🧭" : "⚠️")</div>
        <h1 class="h3 mt-2">@Model.Heading</h1>
        <p class="text-muted">@Model.Text</p>
        <a class="btn btn-primary" asp-page="/Index">Go home</a>
        <a class="btn btn-soft ms-2" asp-page="/Items/Index">Browse items</a>
    </div>
</div>
