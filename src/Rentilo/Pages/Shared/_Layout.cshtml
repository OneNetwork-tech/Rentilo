@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject MessageService MessageService
@{
    var title = ViewData["Title"] as string;
    var description = ViewData["Description"] as string ?? "Rentilo – rent things from people near you instead of buying them.";
    var path = Context.Request.Path.Value ?? "/";
    string Active(string prefix) => path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var signedIn = SignInManager.IsSignedIn(User);
    var unread = signedIn ? await MessageService.UnreadCountAsync(UserManager.GetUserId(User)!) : 0;
    var isAdmin = signedIn && User.IsInRole(Rentilo.Services.Roles.Admin);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@description" />
    <meta name="color-scheme" content="light dark" />
    <title>@(string.IsNullOrEmpty(title) ? "Rentilo – Rent anything nearby" : $"{title} · Rentilo")</title>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="visually-hidden-focusable position-absolute top-0 start-0 m-2 btn btn-primary" href="#main">Skip to content</a>
    <header class="site-nav sticky-top">
        <nav class="navbar navbar-expand-lg py-2" aria-label="Main">
            <div class="container">
                <a class="navbar-brand brand" asp-area="" asp-page="/Index"><span class="brand-mark" aria-hidden="true">R</span>Rentilo</a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto gap-lg-1 mt-2 mt-lg-0">
                        <li class="nav-item"><a class="nav-link @Active("/Items")" asp-area="" asp-page="/Items/Index">Browse</a></li>
                        @if (signedIn)
                        {
                            <li class="nav-item"><a class="nav-link @Active("/Dashboard")" asp-area="" asp-page="/Dashboard/Index">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @(path.StartsWith("/Bookings", StringComparison.OrdinalIgnoreCase) && !path.Contains("Messages", StringComparison.OrdinalIgnoreCase) && !path.Contains("Conversation", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-area="" asp-page="/Bookings/Index">My rentals</a></li>
                            <li class="nav-item">
                                <a class="nav-link @Active("/Bookings/Messages") @Active("/Bookings/Conversation")" asp-area="" asp-page="/Bookings/Messages">
                                    Messages @if (unread > 0) { <span class="badge rounded-pill text-bg-danger nav-badge" aria-label="@unread unread">@unread</span> }
                                </a>
                            </li>
                            @if (isAdmin)
                            {
                                <li class="nav-item"><a class="nav-link @Active("/Admin")" asp-area="" asp-page="/Admin/Index">Admin</a></li>
                            }
                        }
                        <li class="nav-item"><a class="nav-link @Active("/HowItWorks")" asp-area="" asp-page="/HowItWorks">How it works</a></li>
                    </ul>
                    <div class="d-flex align-items-lg-center gap-2 flex-column flex-lg-row py-2 py-lg-0">
                        <a class="btn btn-accent btn-sm" asp-area="" asp-page="/Items/Create">+ List an item</a>
                        <button type="button" class="theme-toggle d-none d-lg-inline-grid" data-theme-toggle aria-label="Toggle theme">🌙</button>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main id="main" role="main">
        <partial name="_Flash" />
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5">
                    <a class="brand mb-2" asp-area="" asp-page="/Index"><span class="brand-mark" aria-hidden="true">R</span>Rentilo</a>
                    <p class="mb-0 mt-2">Rent what you need from people nearby. Earn from the things you already own. Better for your wallet and the planet.</p>
                </div>
                <div class="col-6 col-md-2 offset-md-1">
                    <h3>Explore</h3>
                    <ul>
                        <li><a asp-area="" asp-page="/Items/Index">Browse items</a></li>
                        <li><a asp-area="" asp-page="/Items/Create">List an item</a></li>
                        <li><a asp-area="" asp-page="/HowItWorks">How it works</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-2">
                    <h3>Account</h3>
                    <ul>
                        <li><a asp-area="" asp-page="/Dashboard/Index">Dashboard</a></li>
                        <li><a asp-area="" asp-page="/Bookings/Index">My rentals</a></li>
                        <li><a asp-area="Identity" asp-page="/Account/Manage/Index">Settings</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-2">
                    <h3>Legal</h3>
                    <ul>
                        <li><a asp-area="" asp-page="/Privacy">Privacy</a></li>
                        <li><a asp-area="" asp-page="/Terms">Terms</a></li>
                    </ul>
                </div>
            </div>
            <div class="d-flex justify-content-between flex-wrap gap-2 mt-4 pt-3 border-top">
                <span>&copy; @DateTime.UtcNow.Year Rentilo</span>
                <button type="button" class="btn btn-link p-0 text-decoration-none d-lg-none" data-theme-toggle>🌙</button>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
