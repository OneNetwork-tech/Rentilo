@{
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
}
@if (success is not null || error is not null)
{
    <div class="container mt-3">
        @if (success is not null)
        {
            <div class="alert alert-success flash alert-dismissible fade show" role="status">
                <span aria-hidden="true">✓</span> <span>@success</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (error is not null)
        {
            <div class="alert alert-danger flash alert-dismissible fade show" role="alert">
                <span aria-hidden="true">!</span> <span>@error</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>
}
