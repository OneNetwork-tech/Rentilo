@page
@model EmailModel
@{
    ViewData["Title"] = "Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}
<h2 class="h4">Email</h2>
<partial name="_StatusMessage" for="StatusMessage" />
<form id="email-form" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Current email</label>
        <div class="input-group">
            <input asp-for="Email" class="form-control" disabled />
            @if (Model.IsEmailConfirmed)
            {
                <span class="input-group-text text-success fw-bold" title="Confirmed">✓ Confirmed</span>
            }
            else
            {
                <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-soft">Send verification email</button>
            }
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Input.NewEmail" class="form-label"></label>
        <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" />
        <span asp-validation-for="Input.NewEmail"></span>
    </div>
    <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary">Change email</button>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
