@{
    Layout = "/Pages/Shared/_Layout.cshtml";
}
<div class="container">
    <div class="page-header">
        <span class="eyebrow">Account</span>
        <h1>Settings</h1>
    </div>
    <div class="row g-4">
        <div class="col-md-3">
            <partial name="_ManageNav" />
        </div>
        <div class="col-md-9">
            <div class="form-card">
                @RenderBody()
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
