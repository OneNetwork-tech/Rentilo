# Rentilo server configuration. remote-up.sh creates .env from this file on the first deploy
# and generates POSTGRES_PASSWORD. Edit ~/rentilo/.env on the server, then run:  bash remote-up.sh

# ":80" = plain HTTP on the IP address (testing). A domain name = automatic HTTPS.
SITE_ADDRESS=:80

# Generated on first deploy. Never commit the real value.
POSTGRES_PASSWORD=

# Create demo users and listings (password Rentilo123!) on an empty database.
SEED_DEMO_DATA=false

# Users with these emails (comma separated) get the Admin role: reports, hiding listings, locking users.
ADMIN_EMAILS=

# Require email confirmation before login (only once SMTP below works).
REQUIRE_CONFIRMED_ACCOUNT=false

# Outgoing email (password reset, confirmation). Leave SMTP_HOST empty to only log emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@rentilo.local

# How many days of nightly backups to keep in ~/rentilo/backups.
BACKUP_KEEP_DAYS=14
